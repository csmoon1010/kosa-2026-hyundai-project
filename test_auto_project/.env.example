# .env 로 복사해서 값을 채운다 (.env 는 저장소에 넣지 않는다)

# LLM — ① 요청 이해 · ② 경로 찾기 · ③ API 고르기 · IR 생성
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=           # 예: gpt-5.4 — 가격은 data/config/llm.yaml pricing 에 같은 이름으로

# Parameter KB 벡터 검색 (IR 생성 압축 1) — 저장된 인덱스와 같은 모델이어야 한다
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 개발 서버 주소 (data/config/services.yaml 의 base_url) — 실행기 연결 후 사용. 비우면 명세의 servers[0].url
HMALL_API_BASE_URL=
